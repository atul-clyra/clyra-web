# Where "Log in" / "Get started" point. Defaults to https://app.heyclyra.com when unset.
# For a local preview against the dashboard dev server:
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Book-a-demo form: POST endpoint (see docs/DEMO-REQUESTS.md). Production builds get it from
# .env.production. When unset, the form opens the visitor's email app addressed to
# aditya@heyclyra.com and rohit@heyclyra.com instead.
# NEXT_PUBLIC_DEMO_ENDPOINT=https://api.clyralabs.com/v1/demo-request/
